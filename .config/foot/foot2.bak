[main]
pad =12x12 center
font=JetBrainsMono Nerd Font:size=8
resize-delay-ms=2000
dpi-aware=yes
term="xterm-256color"
title=Foot
initial-window-size-pixels=1000x520

[scrollback]
lines=10000
multiplier=2
indicator-format=percentage
indicator-position=fixed

[url]
launch=xdg-open ${url}
label-letters=sadfjklewcmpgh
osc8-underline=always
#protocols=http, https, ftp, ftps, file, gemini, gopher
#uri-characters=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.,~:;/?#@!$&%*+="'()[]

[cursor]
style=block
blink=yes
beam-thickness=1

[mouse]
hide-when-typing=yes
alternate-scroll-mode=yes

[touch]
long-press-delay=400

[colors]
alpha=0.80
background=0a0e14 
foreground=fffbf6
selection-foreground=b3b1ad
selection-background=b3b1ad

############
## COLORS ##
############

## Normal/regular colors (color palette 0-7)

regular0=01060E  # black
regular1=eb4129  # red
regular2=abe047  # green
regular3=F9AF4F  # yellow
regular4=53BDFA  # blue
regular5=FAE994  # magenta
regular6=99faf2  # cyan
regular7=C7C7C7  # white

## Bright colors (color palette 8-15)
#bright0=08404f   # bright black
#bright1=e35f5c   # bright red
#bright2=9fb700   # bright green
#bright3=d9a400   # bright yellow
#bright4=4ba1de   # bright blue
#bright5=dc619d   # bright magenta
#bright6=32c1b6   # bright cyan
#bright7=ffffff   # bright white


## dimmed colors (see foot.ini(5) man page)
dim0=000408   # dim black
dim1=9b2d1d  # dim red
dim2=6b8c2f  # dim green
dim3=b37a37  # dim yellow
dim4=3a85b2  # dim blue
dim5=b3a56a  # dim magenta
dim6=6bc0b8  # dim cyan
dim7=7f7f7f  # dim white


## The remaining 256-color palette
# 16 = <256-color palette #16>
# ...
# 255 = <256-color palette #255>

## Misc colors
# selection-foreground=<inverse foreground/background>
# selection-background=<inverse foreground/background>
jump-labels=01060E F9AF4F          # black-on-yellow
scrollback-indicator=01060E 4ba1de  # black-on-bright-blue
search-box-no-match=01060E eb4129  # black-on-red
search-box-match=01060E F9AF4F     # black-on-yellow
urls=F9AF4F

[csd]
# preferred=server
# size=26
# font=<primary font>
# color=<foreground color>
# hide-when-maximized=no
# double-click-to-maximize=yes
# border-width=0
# border-color=<csd.color>
# button-width=26
# button-color=<background color>
# button-minimize-color=<regular4>
# button-maximize-color=<regular2>
# button-close-color=<regular1>

[key-bindings]
scrollback-up-page=Shift+Page_Up
scrollback-up-half-page=none
scrollback-up-line=none
scrollback-down-page=Shift+Page_Down
scrollback-down-half-page=none
scrollback-down-line=none
clipboard-copy=ctrl+Shift+c XF86Copy
clipboard-paste=ctrl+Shift+v XF86Paste
primary-paste=Shift+Insert
search-start=ctrl+Shift+r
font-increase=ctrl+plus ctrl+equal ctrl+KP_Add
font-decrease=ctrl+minus ctrl+KP_Subtract
font-reset=ctrl+0 ctrl+KP_0
spawn-terminal=ctrl+Shift+n
minimize=none
maximize=none
fullscreen=F11
pipe-visible=[sh -c "xurls | fuzzel | xargs -r brave-browser"] ctrl+Shift+V
pipe-scrollback=[sh -c "xurls | fuzzel | xargs -r brave-browser"] ctrl+Shift+B
pipe-selected=[xargs -r brave-browser] ctrl+Shift+S
show-urls-launch=Ctrl+Shift+o
show-urls-copy=none
show-urls-persistent=none
prompt-prev=ctrl+Shift+z
prompt-next=ctrl+Shift+x
unicode-input=ctrl+Shift+u
noop=none

[search-bindings]
cancel=ctrl+g ctrl+c Escape
commit=Return
find-prev=ctrl+r
find-next=ctrl+s
cursor-left=Left ctrl+b
cursor-left-word=ctrl+Left Mod1+b
cursor-right=Right ctrl+f
cursor-right-word=ctrl+Right Mod1+f
cursor-home=Home ctrl+a
cursor-end=End ctrl+e
delete-prev=BackSpace
delete-prev-word=Mod1+BackSpace ctrl+BackSpace
delete-next=Delete
delete-next-word=Mod1+d ctrl+Delete
extend-to-word-boundary=ctrl+w
extend-to-next-whitespace=ctrl+Shift+w
clipboard-paste=ctrl+v ctrl+Shift+v ctrl+y XF86Paste
primary-paste=Shift+Insert
unicode-input=none

[url-bindings]
cancel=ctrl+g ctrl+c ctrl+d Escape
toggle-url-visible=t

[text-bindings]
\x03=Mod4+c  # Map Super+c -> Ctrl+c

[mouse-bindings]
selection-override-modifiers=Shift
primary-paste=BTN_MIDDLE
select-begin=BTN_LEFT
select-begin-block=ctrl+BTN_LEFT
select-extend=BTN_RIGHT
select-extend-character-wise=ctrl+BTN_RIGHT
select-word=BTN_LEFT-2
select-word-whitespace=ctrl+BTN_LEFT-2
select-row=BTN_LEFT-4

#nvim: ft=dosini


